# Trading Engine Settings
INITIAL_BALANCE=50000.0
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_LEVERAGE=5
AUTO_TRADING_ENABLED=false
MIN_CONFIDENCE_THRESHOLD=75.0
